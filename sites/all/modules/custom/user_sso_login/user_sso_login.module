function get_api_key(){
	if (!user_is_logged_in()) {
        drupal_json_output(['error' => 'Unauthorized access']);
        drupal_exit();
    }

    $api_key = variable_get('api_secret_token', '');
    
    drupal_json_output(['key' => $api_key]);
    drupal_exit();
}

