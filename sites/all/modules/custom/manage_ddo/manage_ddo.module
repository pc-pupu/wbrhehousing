      'file' => 'ddo_edit_form.inc',
      // 'access arguments' => array('access content')
      'access arguments' => array('administer DDO Management')
    );

    $items['ddo-delete/%'] = array(
      'page callback' => 'ddo_delete',
      'page arguments' => array(1),
      // 'access arguments' => array('access content')
      'access arguments' => array('administer DDO Management')
    );

    $items['ddo-list'] = array(
      'title' => 'DDO List',
      'page callback' => 'ddo_list_view',
