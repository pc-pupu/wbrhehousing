            '<span class="btn bg-success btn-sm fa fa-plus text-white rounded" style="font-size:12px" title="Add to Special Recommendation List"> Add to List</span>' ,
            'special-recommendation/'.encrypt_url($data->online_application_id).'/'.encrypt_url($data->allotment_category).'/', 
            array('html'=>TRUE)).'<br><br>'.l('View Details', 'view-app-det/'.encrypt_url($data->online_application_id), array('html'=>TRUE,'attributes'=> array('target' => '_blank', 'class' => array('btn bg-primary btn-sm px-4.5 rounded-pill text-white fw-bolder')))
          );
          $action_buttons .= '<br><br>';
          if($data->allotment_category == 'Recommended'){ //added dt.13-10-2025
            $action_buttons .= l(
              '<span class="btn bg-success btn-sm fa fa-hourglass-1 text-white rounded" style="font-size:12px" title="Convert to General Category with same waiting list"> Convert to General</span>' , 'convrt-to-gen-cat/'.encrypt_url($data->online_application_id), array('html'=>TRUE));
          }
          $fields[] = $action_buttons; //added dt.13-10-2025
        }
        
        
        //   $fields[] = l(
        //    '<span class="btn bg-danger btn-sm fa fa-trash text-white rounded" style="font-size:12px" ></span>' ,
        //    'estate-treasury-selection/delete/'.encrypt_url($data->housing_treasury_estate_mapping_id).'/', 
        //    array('html'=>TRUE,'attributes'=> array('target' => '_blank','onclick' => $onclick))
        //  );
        
        $rows[] = $fields;
      }

      

      $variables = array(
        'attributes' => array('class'=>array('table table-list table-striped')),
        'header' => $header,
        'rows' => $rows,
        'sticky' => true,
        'empty' => t("No data found!") // The message to be displayed if table is empty
        );
        //end
      //sd turned off 21-06-2024
      if(count($rows) > 0) {
        // Render using Drupal's render API.
        $build['datatable'] = array(
          '#theme' => 'datatable',
          '#header' => $header,
          '#rows' => $rows,
          '#attributes' => array(),
        );
        
        // Or, render using a theme function.
        $variables = array(
          'attributes' => array('class'=>array('table table-list table-striped')),
          'header' => $header,
          'rows' => $rows,
        );
        
        $output = '<div><span style="color:#ff0000" > * Only records with the HRMS id are shown in this list</span>'.theme('datatable', $variables).'</div>';
      }
      else {
        $output = '<div>
                <table class="datatable_no_data_found table table-list">
                  <tr class="tr_no_data_found">
                    <th class="th_no_data_found"></th>
                  </tr>
                  <tr class="tr_no_data_found">
                    <td class="td_no_data_found">No data found!</td>
                  </tr>
                </table>
              </div>';
      }
    }
  }
  
  

  $form['list_content'] = array(
    '#type' => 'markup',
    '#markup' => $output
  );


  return $form;

}

