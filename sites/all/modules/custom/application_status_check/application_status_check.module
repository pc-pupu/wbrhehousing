        $doc_path = file_create_url($doc_data->extra_doc_path);
          $extra_doc_link = l(' Download Supporting Document', $doc_path, array('attributes' => array('target' => '_blank', 'class' => array('btn bg-primary px-6 rounded-pill text-white fw-bolder mb-2 fa fa-download')), 'html' => TRUE)).'<br/>';
      }else{
        $extra_doc_link = '<span color="red">Supporting Document Not Uploaded<br/></span>';
      }
    }

    
    // print_r($extra_query);die;
    $display_output = $extra_doc_link. '
      <div class="table-bottom">
        <table class="table table-list">
          <tr>
            <th colspan="2" style="background: none repeat scroll 0 0 #473a39;color:white;text-align: center;font-size: 18px;line-height: 24px; font-weight: normal;font-family: "Dosis",Arial,Verdana,serif;" class="first">Application Information</th>
          </tr>
