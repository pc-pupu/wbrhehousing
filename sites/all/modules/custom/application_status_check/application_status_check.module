function license_extension_list($form, &$form_state) {
    global $user, $user_role;

    // $userrole_arr = array(7,8);
    $userrole_arr = array(8); // added by Moumita on 19-03-2026

    if(in_array($user_role, $userrole_arr, '===' )){
      $header_str = '<th>Action</th>';
    }else{
      $header_str = '';
    }
  
    // get license_generate and license_extended application list

    $sql = db_select('housing_license_offer_letter_extension', 'hlole');
    $sql->fields('hlole', array());
    $sql->innerJoin('housing_online_application', 'hoa', 'hoa.online_application_id = hlole.online_application_id');
    $sql->fields('hoa', array('status','application_no','online_application_id'));
    $sql->innerJoin('housing_applicant_official_detail', 'haod', 'haod.applicant_official_detail_id = hoa.applicant_official_detail_id');
    $sql->fields('haod',array('hrms_id','applicant_official_detail_id'));
    $sql->innerJoin('housing_applicant', 'ha', 'ha.housing_applicant_id = haod.housing_applicant_id');
    $sql->fields('ha', array('applicant_name'));
    $sql->addField('hlole','status','request_status');
    $sql->condition('hlole.status', array('license_extention_request','license_extended'), 'IN');
    $excute = $sql->execute();

    // echo '<pre>'; print_r($excute->fetchAll()); die;

    if($excute->rowCount() > 0){
        $output = '<table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Application No.</th>
                        <th>HRMS ID</th>
                        <th>Reason for Extension</th>
                        <th>Supporting Document</th>
                        <th>Extended Upto</th>
                        <th>Status</th>
                        '.$header_str.'
                    </tr>
                    </thead>
                    <tbody>';
        foreach($excute->fetchAll() as $record){
            $existing_reason = ucwords(str_replace('_',' ',$record->reason_for_extension));
            $existing_other_reason = $record->reason_for_extension_other;
            $existing_doc_fid = $record->doc_fid;
            $existing_extended_upto = date('d/m/Y',strtotime($record->extended_upto));
            $status = ucwords(str_replace('_',' ',$record->request_status));

            // Load file details
            $file = file_load($existing_doc_fid);
            // Condition added by Subham dt.23-03-2026
            if (!empty($existing_doc_fid) && ($file = file_load($existing_doc_fid))) {
              $file_url = file_create_url($file->uri);
              $file_link = l('<i class="fa fa-file-pdf-o"></i> View', $file_url, array('attributes' => array('target' => '_blank', 'class' => 'btn btn-sm btn-info'), 'html' => TRUE));
            } else {
              $file_link = '<span style="font-size: 0.8em; color: #666;">File not available to download</span>';
            }
            
            $onclickapp="return confirm('Are you sure you want to approve?')";

            $approve_link = l('<span class="fa fa-check"></span> Approve', 'license-extension-status/'.encrypt_url($record->online_application_id).'/approve', array('html'=>TRUE, 'attributes' => array('onclick' => $onclickapp, 'class' => array('btn btn-sm btn-success rounded'))));
            
            $onclickrej="return confirm('Are you sure you want to reject?')";

            $reject_link = l('<span class="fa fa-close"></span> Reject', 'license-extension-status/'.encrypt_url($record->online_application_id).'/reject', array('html'=>TRUE, 'attributes' => array('onclick' => $onclickrej, 'class' => array('btn btn-sm btn-danger rounded'))));

            if($record->request_status == 'license_extention_request'){
                if(in_array($user_role, $userrole_arr, '===' )){
                $row_str = '<td>' . $approve_link .'<br>'. $reject_link .'</td>';
              }else{
                $row_str = '<td></td>';
              }
            }else{
              $row_str = '<td></td>';
            }

            $output .= '<tr>
                            <td>' . check_plain($record->applicant_name) . '</td>
                            <td>' . check_plain($record->application_no) . '</td>
                            <td>' . check_plain($record->hrms_id) . '</td>
                            <td>' . check_plain($existing_reason) .'<br>'. check_plain($existing_other_reason) . ' </td>
                            <td>' . $file_link . '</td>
                            <td>' . check_plain($existing_extended_upto) . '</td>
                            <td>' . $status . ' </td>
                            '.$row_str.'
                        </tr>';
            }
            $output .= '</tbody></table>';

        }else{
          $output = '<div>
                          <table class="datatable_no_data_found table table-list">
                              <tr class="tr_no_data_found">
                                  <th class="th_no_data_found"> No approval request has been raised </th>
                              </tr>
                          </table>
                      </div>';
        }

    $form['list_data'] = array(
    '#type' => 'markup',
    '#markup' => $output,
    );

    return $form;
}

function license_extension_status($online_application_id = '', $action = '') {
    global $base_root, $base_path, $user; 

    // echo $online_application_id.'<br>'.$action;die;
    
    $online_application_id = decrypt_url($online_application_id);
    $action = $action;

    if($online_application_id !=''){
        if($action == 'approve'){
            $update = array('status' => 'license_extended');
            $msg = 'License Extension Request Approved Successfully.';
        }else{
            $update = array('status' => 'license_cancel');
            $msg = 'License Extension Request Rejected Successfully.';
        }

        $update_ex = db_update('housing_license_offer_letter_extension')
        ->fields($update)
        ->condition('online_application_id', $online_application_id, '=')
        ->execute();
        // update housing_online_application status as well
        $update_online_app = db_update('housing_online_application')
                        ->fields(array('status' => $update['status']))
                        ->condition('online_application_id', $online_application_id, '=')
                        ->execute();
        
        $status_id = get_status_id($update['status']);

        // housing_process flow insert
        $insert = array(
            'online_application_id' => $online_application_id,
            'status_id' => $status_id,
            'uid' => $user->uid,
            'short_code' => $update['status'],
            'created_at' => date("Y-m-d H:i:s")
        );

        db_insert('housing_process_flow')
            ->fields($insert)
            ->execute();

        drupal_set_message($msg);
        drupal_goto('license-extension-list');
    }else{
        drupal_set_message('Invalid Request.','error');
        drupal_goto('license-extension-list');
    }
}