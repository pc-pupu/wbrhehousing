			'access arguments' => array('access content'),
		);

		$items['testmail-link'] = array(
			'title' => 'Test Mail',	
			'page callback' => 'check_mail_send_status',
			// 'page arguments' => array(1),
			'access arguments' => array('access content'),
		);

		// added on 14-01-2026 By Moumita
		$items['download-noc/%'] = array(
			'title' => 'No Objection Certificate',	
			'page callback' => 'download_noc',
<<<<<<< HEAD
			'file'=>'download_noc.inc',
			'page arguments' => array(1),
=======
			'page arguments' => array(1),
			'file'=>'download_noc.inc',
>>>>>>> 2502ab393f49b61f25516e6bb0502acbb6d447a0
			'access arguments' => array('access content'),
		);

		return $items;
  	}
    
	function application_status_page($status = '') {
		if(!empty($status))
		$msg = 'Your status: '.$status;
		return $msg;
	}
  
