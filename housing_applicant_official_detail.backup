    office_pin_code bigint,
    gpf_no character varying(100),
    hrms_id bigint,
    office_district bigint,
    office_phone_no character varying(200),
    is_active integer DEFAULT 1 NOT NULL,
    housing_applicant_id bigint
);


ALTER TABLE public.housing_applicant_official_detail OWNER TO postgres;

